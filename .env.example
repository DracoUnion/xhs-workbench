"""本地开发环境配置样例。复制为 .env 后按需修改。"""
# ===== 数据库（PostgreSQL 16）=====
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/xhs_workbench

# ===== Redis（Celery broker）=====
REDIS_URL=redis://localhost:6379/0

# ===== 鉴权 =====
JWT_SECRET=please-change-me-in-your-env
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ===== LLM =====
OPENAI_API_KEY=

# ===== 存储 =====
DATA_DIR=data
LOG_DIR=data/logs

# ===== 手机设备（ADB，可选）=====
ADB_SERIAL=
ADB_HOST=