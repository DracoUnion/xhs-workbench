/* 自媒体 AI 工作台桌面版 — 小红书风格浅色主题 */
/* 主题 token 与 src/theme.py 对齐：primary #ff2e4d，tint #fff1f3。 */
* {
    font-family: "Microsoft YaHei", "PingFang SC", "Segoe UI", sans-serif;
    font-size: 13px;
    color: #1f1f23;
}
QMainWindow, QWidget#page {
    background: #f7f7f8;
}

/* ---------- 侧边栏 ---------- */
QFrame#sidebar {
    background: #1f1f23;
    border-right: 1px solid #1f1f23;
}
QLabel#logo {
    color: #ffffff;
    font-size: 16px;
    font-weight: bold;
    padding: 6px 18px 12px 18px;
}
QListWidget#navList {
    background: transparent;
    border: none;
    outline: none;
    color: #a6adbb;
}
QListWidget#navList::item {
    padding: 10px 20px;
    margin: 0 8px;
    border-radius: 4px;
}
QListWidget#navList::item:hover {
    background: rgba(255, 255, 255, 0.08);
}
QListWidget#navList::item:selected {
    background: #ff2e4d;
    color: #ffffff;
}

/* ---------- 顶栏 ---------- */
QFrame#headerBar {
    background: #ffffff;
    border-bottom: 1px solid #e5e5e7;
}
QLabel#wsBadge {
    color: #389e0d;
    font-size: 12px;
    padding: 4px 10px;
    border: 1px solid #b7eb8f;
    border-radius: 10px;
}
QLabel#userLabel {
    color: #1f2329;
    font-weight: bold;
    padding-right: 8px;
}
QPushButton#linkButton {
    background: transparent;
    border: none;
    color: #ff2e4d;
}

/* ---------- 页面通用 ---------- */
QLabel#pageTitle {
    font-size: 20px;
    font-weight: 600;
}
QLabel#cardTitle {
    font-size: 15px;
    font-weight: 600;
    padding-top: 6px;
}
QLabel#muted {
    color: #8c8c8c;
}
QLabel#infoLabel {
    color: #595959;
    padding: 6px 0;
}
QLabel#infoLabel[error="true"] {
    color: #cf1322;
}
QLabel#notice {
    color: #8c8c8c;
    border: 1px dashed #d9d9d9;
    border-radius: 4px;
    padding: 8px 12px;
    background: #fafafa;
}
QLabel#errorText {
    color: #cf1322;
}
QLabel#statValue {
    font-size: 26px;
    font-weight: bold;
}
QWidget#statCard {
    background: #ffffff;
    border: 1px solid #e5e5e7;
    border-radius: 6px;
}
QLabel#stageBar {
    font-size: 14px;
    color: #ff2e4d;
    background: #ffffff;
    border: 1px solid #e5e5e7;
    border-radius: 6px;
    padding: 10px 14px;
}

/* ---------- 输入控件 ---------- */
QLineEdit, QTextEdit, QPlainTextEdit, QComboBox, QSpinBox {
    background: #ffffff;
    border: 1px solid #d9d9d9;
    border-radius: 4px;
    padding: 4px 8px;
    selection-background-color: #ff2e4d;
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QComboBox:focus, QSpinBox:focus {
    border: 1px solid #ff2e4d;
}
QLineEdit, QComboBox, QSpinBox {
    min-height: 20px;
}

/* ---------- 按钮 ---------- */
QPushButton {
    background: #ffffff;
    border: 1px solid #d9d9d9;
    border-radius: 4px;
    padding: 5px 14px;
    color: #1f2329;
}
QPushButton:hover {
    border-color: #ff2e4d;
    color: #ff2e4d;
}
QPushButton:pressed {
    background: #fff1f3;
}
QPushButton:disabled {
    color: #bfbfbf;
    border-color: #e5e5e7;
    background: #fafafa;
}
QPushButton#primaryButton {
    background: #ff2e4d;
    border: 1px solid #ff2e4d;
    color: #ffffff;
}
QPushButton#primaryButton:hover {
    background: #eb1f43;
}
QPushButton#primaryButton:pressed {
    background: #d93650;
}
QPushButton#primaryButton:disabled {
    background: #bfbfbf;
    border-color: #bfbfbf;
    color: #ffffff;
}

/* ---------- 表格 ---------- */
QTableView {
    background: #ffffff;
    border: 1px solid #e5e5e7;
    border-radius: 4px;
    gridline-color: #f0f0f0;
    selection-background-color: #fff1f3;
    selection-color: #1f2329;
}
QTableView::item {
    padding: 4px 8px;
}
QTableView::item:selected {
    background: #fff1f3;
}
QTableView QHeaderView::section {
    background: #fafafa;
    border: none;
    border-bottom: 1px solid #f0f0f0;
    border-right: 1px solid #f0f0f0;
    padding: 6px 8px;
    font-weight: 600;
    color: #1f2329;
}
QTableView QTableCornerButton::section {
    background: #fafafa;
    border: none;
}

/* ---------- 表单详情块 ---------- */
QFormLayout QLabel {
    color: #595959;
}
QFormLayout QLabel:first-child {
    color: #8c8c8c;
}

/* ---------- 登录页 ---------- */
QLabel#loginLogo {
    font-size: 26px;
    font-weight: bold;
    color: #ff2e4d;
    padding-top: 120px;
}

/* ---------- 对话框 ---------- */
QDialog {
    background: #ffffff;
}